+    def test_url_value_factories_and_metaobject_capabilities_are_accounted_for(self) -> None:
+        mutations = (
+            "import {pathToFileURL as file} from 'node:url'; change(file('/placeholder'));",
+            "const {pathToFileURL: file}=require('url'); change(file('/placeholder'));",
+            "Object.getPrototypeOf(value);", "Object['getOwnPropertySymbols'](value);",
+            "Object.getOwnPropertyDescriptors(value);", "Object.defineProperty(value, key, descriptor);",
+            "Object.setPrototypeOf(value, prototype);", "Reflect.ownKeys(value);",
+            "Reflect.getPrototypeOf(value);", "Reflect.defineProperty(value, key, descriptor);",
+            "const meta=Object; use(meta);", "const meta=(Object); use(meta);",
+            "use(Object);", "Object[computed](value);",
