     requires_url = bool(worker_matches)
     required_meta |= requires_url
 
+    # Preserve the explicit type aliases supported by the integrated contract,
+    # but never erase arbitrary spans through a later semicolon. The complete
+    # ``type Name = URL;`` token shape is unambiguous only when there is no line
+    # terminator after ``type`` (otherwise ASI can leave a runtime assignment).
+    # Exempt only its type reference, not declarations or executable neighbours.
+    for index, (kind, value, _start, end) in enumerate(tokens):
+        if kind != "identifier" or value != "type" or index + 4 >= len(tokens):
+            continue
+        if text(index - 1) in {".", "?."}:
+            continue
+        if any(_is_js_line_terminator(character) for character in source_text[end:tokens[index + 1][2]]):
+            continue
+        if (
+            tokens[index + 1][0] == "identifier"
+            and text(index + 2) == "="
+            and tokens[index + 3][0] == "identifier"
+            and text(index + 3) in url_names
+            and text(index + 4) == ";"
+        ):
+            url_declarations.append((tokens[index + 3][2], tokens[index + 3][3]))
+
     # URL instances can also be acquired from native APIs' internal objects.
     # Do not infer that an unreferenced URL constructor implies an immutable
     # prototype: meta-object capabilities can discover and modify that prototype.
