+    def test_exact_url_type_alias_preserves_runtime_constructor_binding(self) -> None:
+        for declaration in (
+            "import type {URL} from 'node:url';type Address=URL;",
+            "import {type URL} from 'node:url';type Address = URL;",
+            "type Address = URL;",
+        ):
+            with self.subTest(declaration=declaration):
+                self.write(CONTRACT.PERSISTENT_LIFECYCLE_RUNNER, declaration + WORKER + LAUNCH)
+                self.assertIn("scripts/bound.mjs", CONTRACT.runtime_source_paths(self.root))
+
+    def test_contextual_type_identifier_does_not_erase_url_capability_transfer(self) -> None:
+        for separator in ("\n", "\r", "\r\n", "\u2028", "\u2029", "/*\n*/"):
+            source = "let type=0;let Address;type" + separator + "Address=URL;"
+            with self.subTest(separator=separator):
+                self.assert_closed(source + WORKER + LAUNCH)
+        for source in (
+            "type Address=URL;const copy=URL;",
+            "type Address=URL;consume(URL);",
+            "type Address=URL;URL=Fake;",
+        ):
+            with self.subTest(source=source):
+                self.assert_closed(source + WORKER + LAUNCH)
+
