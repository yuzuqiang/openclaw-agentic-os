+    def test_grouped_module_require_calls_bind_the_actual_source(self) -> None:
+        self.write("scripts/hidden.cjs", "module.exports = 42;\n")
+        for depth in (0, 1, 2, 8, 32, 128):
+            base = "(" * depth + "module" + ")" * depth
+            for member in ('["require"]', "?.['require']"):
+                for call in ("(", "?.("):
+                    source = f"{base}{member}{call}'./hidden.cjs');"
+                    with self.subTest(source=source):
+                        self.assertIn("scripts/hidden.cjs", self.snapshot(source))
+
+    def test_grouped_module_require_value_transfers_fail_closed(self) -> None:
+        for depth in (0, 1, 2, 8, 32):
+            base = "(" * depth + "module" + ")" * depth
+            for member in ('["require"]', "?.['require']", ".require"):
+                for transfer in (
+                    "const r={ref}; r('./hidden.cjs');",
+                    "const r=({ref}); r('./hidden.cjs');",
+                    "consume({ref});",
+                    "const holder={{r:{ref}}}; holder.r('./hidden.cjs');",
+                    "const value=`${{consume({ref})}}`;",
+                    "const r={ref}.bind(module); r('./hidden.cjs');",
+                ):
+                    source = transfer.format(ref=base + member)
+                    with self.subTest(source=source), self.assertRaises(SOURCE.RuntimeSourceContractError):
+                        self.snapshot(source)
+
+    @unittest.skipUnless(shutil.which("node"), "requires Node for loader parity")
+    def test_node_grouped_module_require_is_bound_or_rejected(self) -> None:
+        self.write("scripts/hidden.cjs", "console.log('GROUPED_LOADER_EXECUTED');\n")
+        for source, transfer in (
+            ('((module))["require"]("./hidden.cjs");', False),
+            ('(module)?.["require"]?.("./hidden.cjs");', False),
+            ('const r=(module)["require"];r.call(module,"./hidden.cjs");', True),
+        ):
+            with self.subTest(source=source):
+                path = self.write("scripts/grouped.cjs", source)
+                result = subprocess.run([shutil.which("node"), str(path)], cwd=self.root,
+                                        text=True, capture_output=True, check=True, timeout=10)
+                self.assertEqual(result.stdout.strip(), "GROUPED_LOADER_EXECUTED")
+                if transfer:
+                    with self.assertRaises(SOURCE.RuntimeSourceContractError):
+                        self.snapshot(source)
+                else:
+                    self.assertIn("scripts/hidden.cjs", self.snapshot(source))
+
