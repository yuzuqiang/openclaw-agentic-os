+    def test_spread_url_namespace_is_a_capability_transfer_not_member_access(self) -> None:
+        for declaration in (
+            "import * as native from 'node:url';",
+            "import native from 'url';",
+            "const native=require('node:url');",
+        ):
+            for transfer in (
+                "const copy={...native}; change(copy.URL.prototype);",
+                "const copy={...native, marker:1}; change(copy.URL.prototype);",
+                "consume({...native});",
+            ):
+                with self.subTest(declaration=declaration, transfer=transfer):
+                    self.write("scripts/mutator.mjs", declaration + transfer)
+                    self.assert_closed("import './mutator.mjs';" + WORKER + LAUNCH)
+
+    @unittest.skipUnless(NODE, "Node is required for real execution witnesses")
+    def test_node_worker_redirected_by_spread_url_namespace_in_imported_module(self) -> None:
+        for declaration, suffix in (
+            ("import * as native from 'node:url';", "mjs"),
+            ("import native from 'url';", "mjs"),
+            ("const native=require('node:url');", "cjs"),
+        ):
+            with self.subTest(declaration=declaration):
+                mutation = (
+                    declaration + "const copy={...native};"
+                    "Object.defineProperty(copy.URL.prototype,'pathname',{get(){return process.cwd()+'/scripts/hidden.mjs';}});"
+                )
+                self.write("scripts/mutator." + suffix, mutation)
+                source = "import './mutator." + suffix + "';" + WORKER + LAUNCH
+                self.node_witness(source)
+                self.assert_closed(source)
+
